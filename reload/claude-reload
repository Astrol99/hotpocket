#!/usr/bin/env python3
"""claude-reload: run Claude Code across several Claude accounts, switching
to the next account when the current one hits its usage limit.

How it works
  * Each account is a long-lived token from `claude setup-token`. On macOS it is
    stored in the Keychain (service "claude-reload"); on Linux in
    ~/.claude-reload/tokens.json with 0600 permissions (the same way Claude Code
    stores its own Linux login). Override with CLAUDE_RELOAD_STORE=file|keychain.
  * `claude-reload [claude args]` picks the account with the most headroom and
    starts `claude` with CLAUDE_CODE_OAUTH_TOKEN set for that process only
    (your normal `claude` login is untouched).
  * A StopFailure hook (matcher "rate_limit") is injected with --settings. When
    a turn ends on a usage limit, the hook records the session id and stops
    that claude process; the wrapper marks the account exhausted until its
    reset time and resumes the same session on the next account.

Commands
  claude-reload [--use LABEL] [claude args...]   run claude (default command)
  claude-reload add LABEL [--token-stdin]        add or replace an account
  claude-reload import [FILE]                    add accounts from label=token lines
  claude-reload export [LABEL...]                print accounts as label=token lines
  claude-reload status                           show accounts and usage
  claude-reload rm LABEL                         remove an account
  claude-reload reset [LABEL]                    clear "exhausted" marks
  claude-reload update                           git pull the latest version
"""

import concurrent.futures
import fcntl
import getpass
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from contextlib import contextmanager
from datetime import datetime, timedelta
from pathlib import Path

KEYCHAIN_SERVICE = "claude-reload"
HOME = Path(os.environ.get("CLAUDE_RELOAD_HOME", Path.home() / ".claude-reload"))
CONFIG = HOME / "config.json"
STATE = HOME / "state.json"
RUNS = HOME / "runs"
LOG = HOME / "events.log"
HOOKS = HOME / "hooks.json"
TOKENS_FILE = HOME / "tokens.json"
SELF = Path(__file__).resolve()
CLAUDE = os.environ.get("CLAUDE_RELOAD_CLAUDE_BIN", "claude")
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
LABEL_RE = re.compile(r"[A-Za-z0-9._-]{1,64}")
TOKEN_RE = re.compile(r"sk-ant-oat[0-9]*-[A-Za-z0-9_-]+")
FALLBACK_COOLDOWN = 5 * 3600  # used when the reset time can't be determined
RESET_GRACE = 60  # wait this long past a reset before retrying
DEFAULT_CONTINUE = (
    "The previous account hit its usage limit, so this session was moved to "
    "another account. Continue what you were working on; do not repeat work "
    "that is already complete."
)
SESSION_FLAGS = {"-c", "--continue", "-r", "--resume", "--session-id",
                 "--fork-session", "--from-pr"}


def say(msg):
    print(f"\033[2m[claude-reload]\033[0m {msg}", file=sys.stderr, flush=True)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


# --------------------------------------------------------------------------- storage

def _load(path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def _save(path, data):
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


@contextmanager
def _locked(path, default):
    """Read-modify-write a JSON file under an exclusive lock (safe across wrappers)."""
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(HOME / ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = _load(path, default)
        yield data
        _save(path, data)


def load_config():
    cfg = _load(CONFIG, {})
    cfg.setdefault("profiles", [])
    return cfg


def locked_config():
    return _locked(CONFIG, {"profiles": []})


def locked_state():
    return _locked(STATE, {"profiles": {}})


def log_event(kind, **fields):
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(json.dumps({"t": datetime.now().isoformat(timespec="seconds"),
                            "event": kind, **fields}) + "\n")


# --------------------------------------------------------------------------- token store

def token_store():
    choice = os.environ.get("CLAUDE_RELOAD_STORE")
    if choice in ("keychain", "file"):
        return choice
    return "keychain" if sys.platform == "darwin" else "file"


def store_description():
    return "macOS Keychain" if token_store() == "keychain" else str(TOKENS_FILE)


def token_get(label):
    if token_store() == "file":
        return _load(TOKENS_FILE, {}).get(label)
    r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
                        "-a", label, "-w"], capture_output=True, text=True)
    return r.stdout.strip() or None if r.returncode == 0 else None


def token_set(label, token):
    if token_store() == "file":
        with _locked(TOKENS_FILE, {}) as tokens:
            tokens[label] = token
        return
    # Fed through `security -i` on stdin so the token never shows up in `ps`.
    subprocess.run(["security", "-i"], text=True, capture_output=True,
                   input=f"add-generic-password -U -s {KEYCHAIN_SERVICE} -a {label} -w {token}\n")
    if token_get(label) != token:
        die("Could not save the token to the Keychain.")


def token_delete(label):
    if token_store() == "file":
        with _locked(TOKENS_FILE, {}) as tokens:
            tokens.pop(label, None)
        return
    subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE,
                    "-a", label], capture_output=True)


def save_account(label, token):
    token_set(label, token)
    with locked_config() as cfg:
        if label not in cfg["profiles"]:
            cfg["profiles"].append(label)
    with locked_state() as st:
        st["profiles"].pop(label, None)


# --------------------------------------------------------------------------- usage

def _epoch(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def fetch_usage(token):
    """Return {'five_hour': {'pct', 'reset'}, 'seven_day': {...}} or {'error': str}."""
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "claude-reload",
    })
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}"}
    except Exception as e:  # network down, timeout, bad JSON
        return {"error": type(e).__name__}
    out = {}
    for key in ("five_hour", "seven_day"):
        w = data.get(key) or {}
        out[key] = {"pct": w.get("utilization"), "reset": _epoch(w.get("resets_at"))}
    # Any maxed-out limit (session, weekly, or a per-model weekly) blocks the account.
    until = max([out[k]["reset"] or 0 for k in out if (out[k]["pct"] or 0) >= 100] or [0])
    for lim in data.get("limits") or []:
        if (lim.get("percent") or 0) >= 100:
            until = max(until, _epoch(lim.get("resets_at")) or 0)
    out["blocked_until"] = until
    return out


def blocked_until(usage):
    """Epoch until which the account is out of quota per the usage API, else 0."""
    return usage.get("blocked_until", 0)


def pct(usage, key):
    v = (usage.get(key) or {}).get("pct")
    return f"{v:.0f}%" if v is not None else "-"


def headroom_score(usage):
    pcts = [w["pct"] for w in (usage.get("five_hour"), usage.get("seven_day"))
            if w and w["pct"] is not None]
    return max(pcts) if pcts else 0


def usage_for(labels):
    tokens = {l: token_get(l) for l in labels}
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futs = {l: pool.submit(fetch_usage, t) for l, t in tokens.items() if t}
        usage = {l: f.result() for l, f in futs.items()}
    return tokens, usage


def parse_reset_from_message(msg):
    """Best effort: '... resets 3pm', '... resets 4:30am', '... resets Nov 8, 3pm'."""
    m = re.search(r"resets\s+(?:([A-Z][a-z]{2})\s+(\d{1,2}),?\s+(?:at\s+)?)?"
                  r"(\d{1,2})(?::(\d{2}))?\s*([ap]m)", msg or "", re.I)
    if not m:
        return None
    mon, day, hour, minute, ampm = m.groups()
    hour = int(hour) % 12 + (12 if ampm.lower() == "pm" else 0)
    now = datetime.now()
    when = now.replace(hour=hour, minute=int(minute or 0), second=0, microsecond=0)
    if mon and day:
        try:
            when = datetime.strptime(f"{mon} {day} {now.year} {when:%H:%M}", "%b %d %Y %H:%M")
        except ValueError:
            return None
        if when < now - timedelta(days=1):
            when = when.replace(year=now.year + 1)
    elif when <= now:
        when += timedelta(days=1)
    return when.timestamp()


def fmt_time(ts):
    if not ts:
        return "-"
    dt = datetime.fromtimestamp(ts)
    return dt.strftime("%-I:%M%p").lower() if dt.date() == datetime.now().date() \
        else dt.strftime("%a %-I:%M%p").replace("AM", "am").replace("PM", "pm")


# --------------------------------------------------------------------------- picking

def pick_account(profiles, prefer=None):
    """Return (label, token, usage-or-None) for the account with the most headroom."""
    now = time.time()
    local = _load(STATE, {"profiles": {}})["profiles"]
    candidates = [l for l in profiles if local.get(l, {}).get("exhausted_until", 0) <= now]
    if prefer and prefer not in profiles:
        die(f"No account named '{prefer}'. Run `claude-reload status`.")
    if not candidates:
        return None
    tokens, usage = usage_for(candidates)
    ranked = []
    for order, label in enumerate(candidates):
        if not tokens.get(label):
            continue
        u = usage.get(label, {})
        if "error" not in u:
            until = blocked_until(u)
            if until > now:
                mark_exhausted(label, until, source="usage-api")
                continue
            score = headroom_score(u)
        else:
            score, u = 0, None  # unknown usage: treat as fresh
        ranked.append((-1 if label == prefer else score, order, label, u))
    if not ranked:
        return None
    _, _, label, u = min(ranked)
    return label, tokens[label], u


def mark_exhausted(label, until, source):
    with locked_state() as st:
        st["profiles"].setdefault(label, {})["exhausted_until"] = until
    log_event("exhausted", profile=label, until=fmt_time(until), source=source)


def soonest_reset(profiles):
    st = _load(STATE, {"profiles": {}})
    times = [st["profiles"].get(l, {}).get("exhausted_until", 0) for l in profiles]
    times = [t for t in times if t > time.time()]
    return min(times) if times else None


# --------------------------------------------------------------------------- argv handling

_VALUE_OPTS = None


def value_options():
    """Options from `claude --help` that take a value: (required, optional, variadic)."""
    global _VALUE_OPTS
    if _VALUE_OPTS is None:
        out = subprocess.run([CLAUDE, "--help"], capture_output=True, text=True).stdout
        req, opt, var = set(), set(), set()
        for m in re.finditer(r"^\s{2}((?:-\w, )?--[\w-]+(?:, --[\w-]+)*) ([<\[])([^>\]]*)",
                             out, re.M):
            names = re.findall(r"--?[\w-]+", m.group(1))
            (req if m.group(2) == "<" else opt).update(names)
            if m.group(3).endswith("..."):
                var.update(names)
        _VALUE_OPTS = (req, opt, var)
    return _VALUE_OPTS


def args_for_resume(args):
    """Keep the user's flags but drop the prompt and any session-selecting flags."""
    req, opt, var = value_options()
    keep, i = [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break  # everything after `--` is positional (the prompt)
        if not a.startswith("-") or a == "-":
            i += 1  # positional prompt: drop
            continue
        name = a.split("=", 1)[0]
        group = [a]
        i += 1
        if "=" not in a:
            if name in var:
                while i < len(args) and not args[i].startswith("-"):
                    group.append(args[i]); i += 1
            elif name in req and i < len(args):
                group.append(args[i]); i += 1
            elif name in opt and i < len(args) and not args[i].startswith("-"):
                group.append(args[i]); i += 1
        if name not in SESSION_FLAGS:
            keep.extend(group)
    return keep


def write_hooks_file():
    cmd = f"{shlex.quote(sys.executable)} -I {shlex.quote(str(SELF))} hook"
    _save(HOOKS, {"hooks": {"StopFailure": [
        {"matcher": "rate_limit", "hooks": [{"type": "command", "command": cmd, "timeout": 30}]}
    ]}})


# --------------------------------------------------------------------------- commands

def cmd_run(argv):
    prefer = None
    if argv[:1] == ["--use"]:
        if len(argv) < 2:
            die("Usage: claude-reload --use LABEL [claude args]")
        prefer, argv = argv[1], argv[2:]
    cfg = load_config()
    profiles = cfg["profiles"]
    if not profiles:
        die("No accounts yet. Add one with: claude-reload add <label>")
    continue_prompt = cfg.get("continue_prompt", DEFAULT_CONTINUE)

    env_base = os.environ.copy()
    for var in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"):
        if env_base.pop(var, None):
            say(f"Ignoring {var} for this session so the account tokens are used.")
    write_hooks_file()
    RUNS.mkdir(mode=0o700, parents=True, exist_ok=True)

    # Ctrl-C belongs to claude. A Python-level handler (not SIG_IGN) is reset
    # on exec, so the child still gets normal signal behaviour.
    signal.signal(signal.SIGINT, lambda *_: None)
    signal.signal(signal.SIGQUIT, lambda *_: None)

    session, args = None, argv
    while True:
        picked = pick_account(profiles, prefer=prefer)
        prefer = None  # --use only applies to the first launch
        if picked is None:
            if not wait_for_reset(profiles, session):
                return 1
            continue
        label, token, usage = picked
        detail = f" (5h {pct(usage, 'five_hour')}, 7d {pct(usage, 'seven_day')} used)" if usage else ""
        say(f"{'Resuming' if session else 'Starting'} on account '{label}'{detail}")
        with locked_state() as st:
            st["profiles"].setdefault(label, {})["last_used"] = time.time()

        run_id = uuid.uuid4().hex
        env = dict(env_base, CLAUDE_CODE_OAUTH_TOKEN=token, CLAUDE_RELOAD_PROFILE=label,
                   CLAUDE_RELOAD_RUN=run_id, CLAUDE_RELOAD_WRAPPER_PID=str(os.getpid()))
        cmd = [CLAUDE, "--settings", str(HOOKS), *args]
        try:
            rc = subprocess.Popen(cmd, env=env).wait()
        except FileNotFoundError:
            die(f"Could not find `{CLAUDE}` on PATH.")

        marker = RUNS / f"{run_id}.json"
        if not marker.exists():
            return rc  # claude exited for some other reason: we're done
        info = json.loads(marker.read_text())
        marker.unlink()
        if sys.stdin.isatty():
            subprocess.run(["stty", "sane"], stderr=subprocess.DEVNULL)

        # When does this account come back? Usage API > message text > fallback.
        u = fetch_usage(token)
        until, source = blocked_until(u), "usage-api"
        if not until:
            until, source = parse_reset_from_message(info.get("last_assistant_message")) or 0, "message"
        if not until and "error" not in u:
            # The API says nothing is maxed out: most likely a short throttle.
            until, source = time.time() + 15 * 60, "throttle-15m"
        if not until:
            until, source = time.time() + FALLBACK_COOLDOWN, "fallback-5h"
        mark_exhausted(label, until, source)
        say(f"Account '{label}' hit its usage limit (back at {fmt_time(until)}). Switching accounts...")

        session = info.get("session_id") or session
        if not session:
            die("Could not determine the session id to resume.")
        args = [*args_for_resume(argv), "--resume", session, continue_prompt]


def wait_for_reset(profiles, session):
    reset = soonest_reset(profiles)
    if not reset:
        say("No usable accounts (missing tokens?). Run `claude-reload status`.")
        return False
    resume = f"claude-reload --resume {session}" if session else "claude-reload"
    say(f"All accounts are out of quota. The first one resets at {fmt_time(reset)}.")
    say(f"Waiting, then continuing automatically. Ctrl-C to stop (later: {resume}).")
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        while time.time() < reset + RESET_GRACE:
            time.sleep(min(30, max(1, reset + RESET_GRACE - time.time())))
    except KeyboardInterrupt:
        print(file=sys.stderr)
        say(f"Stopped. Pick up later with: {resume}")
        sys.exit(130)
    finally:
        signal.signal(signal.SIGINT, lambda *_: None)
    with locked_state() as st:  # let the API re-check accounts that should be back
        for l in profiles:
            p = st["profiles"].get(l, {})
            if p.get("exhausted_until", 0) <= time.time():
                p.pop("exhausted_until", None)
    return True


def cmd_hook(_argv):
    """StopFailure hook. Runs inside claude; must never raise."""
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    run_id = os.environ.get("CLAUDE_RELOAD_RUN")
    wrapper_pid = os.environ.get("CLAUDE_RELOAD_WRAPPER_PID", "")
    log_event("stop_failure", profile=os.environ.get("CLAUDE_RELOAD_PROFILE"),
              error=payload.get("error"), details=payload.get("error_details"),
              message=payload.get("last_assistant_message"),
              session=payload.get("session_id"))
    if payload.get("error") != "rate_limit" or not (run_id and wrapper_pid.isdigit()):
        return 0
    RUNS.mkdir(mode=0o700, parents=True, exist_ok=True)
    _save(RUNS / f"{run_id}.json", {
        "session_id": payload.get("session_id"),
        "last_assistant_message": payload.get("last_assistant_message"),
        "error_details": payload.get("error_details"),
    })
    time.sleep(1)  # let claude finish writing the transcript
    # Walk up from this hook to the claude process the wrapper started, then stop it.
    pid = os.getppid()
    while pid > 1:
        ppid = parent_pid(pid)
        if ppid == int(wrapper_pid):
            os.kill(pid, signal.SIGTERM)
            break
        pid = ppid
    return 0


def parent_pid(pid):
    try:  # Linux
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):  # macOS / no procfs
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.strip()
        return int(out) if out.isdigit() else 0


def cmd_add(argv):
    if not argv or not LABEL_RE.fullmatch(argv[0]):
        die("Usage: claude-reload add LABEL [--token-stdin]   (letters, digits, . _ -)")
    label = argv[0]
    if "--token-stdin" in argv[1:]:
        token = sys.stdin.read().strip()
    else:
        print(f"\nAdding account '{label}'.\n"
              "Claude Code will open a browser (or print a link) to authorize a token.\n"
              f"Make sure you are signed in to claude.ai as the account you want for '{label}'\n"
              "(a private window or switching accounts first avoids picking the wrong one).\n",
              file=sys.stderr)
        input("Press Enter to continue...")
        subprocess.run([CLAUDE, "setup-token"])
        token = getpass.getpass("\nPaste the token printed above (input hidden): ").strip()
    token = re.sub(r"\s+", "", token)
    if not TOKEN_RE.fullmatch(token):
        die("That doesn't look like a Claude Code token (expected sk-ant-oat...).")
    save_account(label, token)
    u = fetch_usage(token)
    if "error" in u:
        say(f"Saved '{label}'. Usage lookup isn't available for this token ({u['error']}); "
            "switching will still happen when a limit is hit.")
    else:
        say(f"Saved '{label}'. Current usage: 5h {pct(u, 'five_hour')}, 7d {pct(u, 'seven_day')}.")


def cmd_status(_argv):
    profiles = load_config()["profiles"]
    if not profiles:
        die("No accounts yet. Add one with: claude-reload add <label>", 0)
    tokens, usage = usage_for(profiles)
    st = _load(STATE, {"profiles": {}})
    now = time.time()
    rows = [("ACCOUNT", "5H", "7D", "5H RESETS", "7D RESETS", "STATE")]
    for l in profiles:
        u = usage.get(l, {})
        p = st["profiles"].get(l, {})
        if not tokens.get(l):
            rows.append((l, "-", "-", "-", "-", "no token saved"))
            continue
        if "error" in u:
            five = seven = r5 = r7 = "?"
        else:
            five, seven = pct(u, "five_hour"), pct(u, "seven_day")
            r5, r7 = fmt_time(u["five_hour"]["reset"]), fmt_time(u["seven_day"]["reset"])
        until = p.get("exhausted_until", 0)
        state = f"limited until {fmt_time(until)}" if until > now else "ready"
        if "error" in u:
            state += f" (usage n/a: {u['error']})"
        rows.append((l, five, seven, r5, r7, state))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    print(f"\nTokens stored in: {store_description()}")


def cmd_import(argv):
    """Read `label=token` lines (blank lines and # comments ignored)."""
    text = Path(argv[0]).read_text() if argv else sys.stdin.read()
    entries = []
    for n, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        label, sep, token = line.partition("=")
        label, token = label.strip(), re.sub(r"\s+", "", token)
        if not sep or not LABEL_RE.fullmatch(label) or not TOKEN_RE.fullmatch(token):
            die(f"Line {n} isn't `label=sk-ant-oat...` (nothing was imported).")
        entries.append((label, token))
    if not entries:
        die("No accounts found in the input.")
    for label, token in entries:
        save_account(label, token)
    say(f"Imported {len(entries)} account(s): {', '.join(l for l, _ in entries)}. "
        "Check them with `claude-reload status`.")


def cmd_export(argv):
    labels = argv or load_config()["profiles"]
    if sys.stdout.isatty():
        say("These are live credentials. Share them only through a password manager.")
    for label in labels:
        token = token_get(label)
        if token:
            print(f"{label}={token}")
        else:
            say(f"Skipping '{label}': no token saved.")


def cmd_update(_argv):
    repo = SELF.parent
    if not (repo / ".git").exists():
        die(f"{repo} isn't a git checkout, so it can't update itself. Reinstall instead.")
    return subprocess.run(["git", "-C", str(repo), "pull", "--ff-only"]).returncode


def cmd_rm(argv):
    if not argv:
        die("Usage: claude-reload rm LABEL")
    label = argv[0]
    token_delete(label)
    with locked_config() as cfg:
        cfg["profiles"] = [p for p in cfg["profiles"] if p != label]
    with locked_state() as st:
        st["profiles"].pop(label, None)
    say(f"Removed '{label}'.")


def cmd_reset(argv):
    with locked_state() as st:
        for label, p in st["profiles"].items():
            if not argv or label in argv:
                p.pop("exhausted_until", None)
    say("Cleared usage-limit marks.")


COMMANDS = {"add": cmd_add, "import": cmd_import, "export": cmd_export,
            "status": cmd_status, "ls": cmd_status, "rm": cmd_rm, "reset": cmd_reset,
            "update": cmd_update, "hook": cmd_hook}


def main():
    argv = sys.argv[1:]
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return 0
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:]) or 0
    if argv[:1] == ["run"]:
        argv = argv[1:]
    return cmd_run(argv)


if __name__ == "__main__":
    sys.exit(main())
