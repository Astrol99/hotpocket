[Unit]
Description=Claude Code team gateway

[Service]
User=claude-gateway
ExecStart=/opt/claude-gateway/.venv/bin/claude-gateway serve
StateDirectory=claude-gateway
StateDirectoryMode=0700
Restart=always
RestartSec=2

# Hardening: the service only needs to read/write its own state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
